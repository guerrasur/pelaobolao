rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function own(uid) { return signed() && request.auth.uid == uid; }
    function room(id) { return get(/databases/$(database)/documents/rooms/$(id)).data; }
    function roomAfter(id) { return getAfter(/databases/$(database)/documents/rooms/$(id)).data; }
    function member(r) { return signed() && request.auth.uid in r.members && !r.members[request.auth.uid].left; }
    function host(r) { return member(r) && r.hostId == request.auth.uid; }
    function game(id) { return get(/databases/$(database)/documents/games/$(id)).data; }
    function participant(g) { return signed() && request.auth.uid in g.memberIds && member(room(g.roomId)); }
    function gameHost(g) { return host(room(g.roomId)) && room(g.roomId).gameId != null; }
    function synced(g) { return g.get('protocolVersion', 1) == 2; }
    function marked(g, field, index) {
      return g.memberIds.size() <= index || g.players[g.memberIds[index]].hair <= 0
        || g[field].get(g.memberIds[index], false) == true;
    }
    function allMarked(g, field) {
      return marked(g, field, 0) && marked(g, field, 1) && marked(g, field, 2)
        && marked(g, field, 3) && marked(g, field, 4) && marked(g, field, 5);
    }
    function deadline(g) {
      return synced(g) ? g.phaseStartedAt.toMillis() + g.rules.turnMs : g.deadline;
    }
    function validMember(m) {
      return m.keys().hasOnly(['name','joinedAt','lastSeenAt','left','ready'])
        && m.name is string && m.name.size() > 0 && m.name.size() <= 24
        && m.joinedAt is number && m.lastSeenAt is timestamp && m.left is bool && m.ready is bool;
    }
    match /profiles/{uid} {
      allow read: if own(uid);
      allow create: if own(uid) && request.resource.data.keys().hasOnly(['name','schemaVersion','dataVersion','createdAt','updatedAt'])
        && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if own(uid) && resource.data.schemaVersion == 1 && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','schemaVersion','dataVersion','updatedAt']);
      function validProfile() {
        let d = request.resource.data;
        return d.schemaVersion == 1 && d.dataVersion == 1 && d.name is string && d.name.size() > 0 && d.name.size() <= 24
          && d.updatedAt == request.time;
      }
    }
    match /progress/{uid} { allow read: if own(uid); allow write: if false; }
    match /sessions/{uid} {
      allow read: if own(uid);
      allow create, update: if own(uid) && request.resource.data.keys().hasOnly(['roomId','updatedAt','clockAt'])
        && (!('roomId' in request.resource.data) || request.resource.data.roomId == null || request.resource.data.roomId is string)
        && (!('clockAt' in request.resource.data) || request.resource.data.clockAt is timestamp);
    }
    match /rooms/{id} {
      // Exact-code lobby lookup is required to join. No enumeration is allowed.
      allow get: if signed() && (!exists(/databases/$(database)/documents/rooms/$(id)) || resource.data.status == 'lobby'
        || request.auth.uid in resource.data.members);
      allow list: if false;
      allow create: if signed() && id.matches('^[A-Z2-9]{4}$') && validRoom()
        && request.resource.data.hostId == request.auth.uid && request.resource.data.status == 'lobby'
        && request.resource.data.gameId == null && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && validMember(request.resource.data.members[request.auth.uid])
        && !request.resource.data.members[request.auth.uid].left
        && request.resource.data.members[request.auth.uid].lastSeenAt == request.time;
      allow update: if signed() && validRoom() && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && (host(resource.data) || selfChange() || takeover());
      function validRoom() {
        let d = request.resource.data;
        return d.keys().hasOnly(['schemaVersion','code','hostId','status','gameId','members','createdAt','updatedAt'])
          && d.schemaVersion == 3 && d.code == id && d.members is map && d.members.size() <= 6
          && d.status in ['lobby','playing','finished','closed'] && d.updatedAt == request.time
          && (d.status == 'closed' || (d.hostId in d.members && !d.members[d.hostId].left));
      }
      function ownMemberChange() {
        let uid = request.auth.uid;
        let d = request.resource.data;
        return d.members.diff(resource.data.members).affectedKeys().hasOnly([uid])
          && ((uid in d.members && validMember(d.members[uid]) && d.members[uid].lastSeenAt == request.time
            && ((uid in resource.data.members && d.members[uid].joinedAt == resource.data.members[uid].joinedAt)
              || (resource.data.status == 'lobby' && !d.members[uid].left)))
          || (!(uid in d.members) && uid in resource.data.members && resource.data.status == 'lobby'));
      }
      function selfChange() {
        return resource.data.status != 'closed' && ownMemberChange()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','updatedAt']);
      }
      function takeover() {
        let old = resource.data;
        return member(old) && request.resource.data.hostId == request.auth.uid
          && (old.members[old.hostId].left || request.time > old.members[old.hostId].lastSeenAt + duration.value(45,'s'))
          && ownMemberChange()
          && request.resource.data.diff(old).affectedKeys().hasOnly(['hostId','members','updatedAt']);
      }
    }
    match /games/{id} {
      allow read: if participant(resource.data);
      allow create: if validGameCreate();
      allow update: if participant(resource.data) && (selfSignal()
        || (host(room(resource.data.roomId)) && room(resource.data.roomId).gameId == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','lastResult','resolvedTurn','phase','winnerId','draw','nextTurnAt','finishedAt','turn','deadline','countdownEndsAt','phaseStartedAt','ready','chosen'])
        && validGameTransition()));
      function selfSignal() {
        let g = resource.data;
        let d = request.resource.data;
        let uid = request.auth.uid;
        return synced(g) && (
          (g.phase in ['countdown','syncing'] && d.diff(g).affectedKeys().hasOnly(['ready'])
            && d.ready.diff(g.ready).affectedKeys().hasOnly([uid]) && d.ready[uid] == true)
          || (g.phase == 'choosing' && request.time.toMillis() < deadline(g) && !allMarked(g, 'chosen')
            && d.diff(g).affectedKeys().hasOnly(['chosen'])
            && d.chosen.diff(g.chosen).affectedKeys().hasOnly([uid]) && d.chosen[uid] == true
            && getAfter(/databases/$(database)/documents/games/$(id)/intents/$(uid)).data.turn == g.turn
            && getAfter(/databases/$(database)/documents/games/$(id)/intents/$(uid)).data.submittedAt == request.time));
      }
      function validGameCreate() {
        let d = request.resource.data;
        let oldRoom = room(d.roomId);
        let nextRoom = roomAfter(d.roomId);
        return signed() && oldRoom.hostId == request.auth.uid && oldRoom.status == 'lobby'
          && nextRoom.status == 'playing' && nextRoom.gameId == id
          && (!synced(d) || (d.phase == 'countdown' && d.phaseStartedAt == request.time && d.ready == {} && d.chosen == {}))
          && d.schemaVersion == 3 && d.memberIds.size() >= 2 && d.memberIds.size() <= 6;
      }
      function validGameTransition() {
        let old = resource.data;
        let d = request.resource.data;
        return synced(old) ? synchronizedTransition(old, d) : ((old.phase == 'countdown'
            && request.time.toMillis() >= old.countdownEndsAt
            && d.phase == 'choosing' && d.turn == old.turn && d.resolvedTurn == old.resolvedTurn
            && d.countdownEndsAt == null && d.deadline > request.time.toMillis()
            && d.diff(old).affectedKeys().hasOnly(['phase','deadline','countdownEndsAt']))
          || (old.phase == 'choosing'
            && request.time.toMillis() >= old.deadline
            && d.turn == old.turn && d.resolvedTurn == old.turn && d.lastResult.turn == old.turn
            && d.phase in ['reveal','finished']
            && existsAfter(/databases/$(database)/documents/games/$(id)/rounds/$(string(old.turn)))
            && ((d.phase == 'reveal' && d.nextTurnAt > request.time.toMillis())
              || (d.phase == 'finished' && d.nextTurnAt == null)))
          || (old.phase == 'reveal'
            && request.time.toMillis() >= old.nextTurnAt
            && d.phase == 'choosing' && d.turn == old.turn + 1 && d.resolvedTurn == old.resolvedTurn
            && d.deadline > request.time.toMillis() && d.nextTurnAt == null
            && d.diff(old).affectedKeys().hasOnly(['phase','turn','deadline','nextTurnAt'])));
      }
      function synchronizedTransition(old, d) {
        let time = request.time.toMillis();
        return ((old.phase == 'countdown'
              && time >= old.phaseStartedAt.toMillis() + old.rules.countdownMs
              && (allMarked(old, 'ready') || time >= old.phaseStartedAt.toMillis() + old.rules.countdownMs + 15000)
            || old.phase == 'syncing' && (allMarked(old, 'ready') || time >= old.phaseStartedAt.toMillis() + 15000))
          && d.phase == 'choosing' && d.phaseStartedAt == request.time && d.countdownEndsAt == null
          && d.diff(old).affectedKeys().hasOnly(['phase','phaseStartedAt','deadline','countdownEndsAt']))
        || (old.phase == 'choosing' && (time >= deadline(old) || allMarked(old, 'chosen'))
          && d.phase == 'locked' && d.diff(old).affectedKeys().hasOnly(['phase']))
        || (old.phase == 'locked' && d.turn == old.turn && d.resolvedTurn == old.turn
          && d.lastResult.turn == old.turn && d.phase in ['reveal','finished']
          && d.phaseStartedAt == request.time
          && d.diff(old).affectedKeys().hasOnly(['players','lastResult','resolvedTurn','phase','winnerId','draw','nextTurnAt','finishedAt','phaseStartedAt'])
          && existsAfter(/databases/$(database)/documents/games/$(id)/rounds/$(string(old.turn))))
        || (old.phase == 'reveal' && time >= old.phaseStartedAt.toMillis() + old.rules.revealMs
          && d.phase == 'syncing' && d.turn == old.turn + 1 && d.phaseStartedAt == request.time
          && d.ready == {} && d.chosen == {} && d.nextTurnAt == null
          && d.diff(old).affectedKeys().hasOnly(['phase','phaseStartedAt','turn','deadline','nextTurnAt','ready','chosen']));
      }
      match /intents/{uid} {
        allow get: if canReadIntent(uid);
        allow list: if false;
        allow create, update: if own(uid) && participant(game(id)) && validIntent();
        function canReadIntent(intentUid) {
          let g = game(id);
          return participant(g) && (own(intentUid)
            || (host(room(g.roomId)) && (synced(g) ? g.phase in ['locked','reveal','finished'] : request.time.toMillis() >= g.deadline)));
        }
        function validIntent() {
          let g = game(id); let d = request.resource.data;
          return g.phase == 'choosing' && request.time.toMillis() < deadline(g) && g.players[uid].hair > 0
            && (!synced(g) || (!allMarked(g, 'chosen')
              && getAfter(/databases/$(database)/documents/games/$(id)).data.chosen[uid] == true))
            && d.keys().hasOnly(['turn','action','target','requestId','revision','submittedAt'])
            && d.turn == g.turn && d.requestId is string && d.revision is int && d.submittedAt == request.time
            && ((d.action in ['air','hide'] && d.target == null)
              || (d.action == 'blow' && d.target is string && d.target != uid && d.target in g.memberIds && g.players[d.target].hair > 0 && g.players[uid].breath > 0));
        }
      }
      match /rounds/{turnId} {
        allow read: if participant(game(id));
        allow create: if validRoundCreate();
        allow update, delete: if false;
        function validRoundCreate() {
          let g = game(id);
          let r = room(g.roomId);
          let d = request.resource.data;
          return signed() && request.auth.uid in g.memberIds && member(r) && r.hostId == request.auth.uid
            && (synced(g) ? g.phase == 'locked' : g.phase == 'choosing' && request.time.toMillis() >= g.deadline)
            && turnId == string(g.turn)
            && d.keys().hasOnly(['turn','actions','hits','losses','resolvedBy','resolvedAt'])
            && d.turn == g.turn && d.resolvedBy == request.auth.uid && d.resolvedAt == request.time;
        }
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
