{
  "name": "pelaobolao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/game.test.js",
    "test:integration": "firebase emulators:exec --project demo-pelaobolao --only firestore \"node --test --test-concurrency=1 tests/integration.test.js tests/rules.test.js\"",
    "test:e2e": "firebase emulators:exec --project demo-pelaobolao --only auth,firestore,functions \"playwright test\"",
    "test:e2e:portable": "firebase emulators:exec --project demo-pelaobolao --only auth,firestore \"node tests/support/portable-functions.mjs\"",
    "emulators": "firebase emulators:start --project demo-pelaobolao",
    "config:ci": "node scripts/config-ci.mjs"
  },
  "dependencies": { "firebase": "12.19.0" },
  "devDependencies": {
    "vite": "8.3.0",
    "firebase-tools": "15.30.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0"
  },
  "engines": { "node": ">=22.12.0" }
}
